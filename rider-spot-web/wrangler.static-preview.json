{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rider-spot-static-preview",
  "main": "edge/static-edge.mjs",
  "compatibility_date": "2026-11-19",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/", "/index.html", "/sw.js", "/api/*", "/auth/*", "/oauth/*"]
  },
  "services": [
    { "binding": "LEGACY", "service": "rider-spot" }
  ]
}
